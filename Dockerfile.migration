# OpenMind Migration Coordinator
# Handles autonomous cloud migration

FROM node:18-alpine

# Install system dependencies
RUN apk add --no-cache \
    curl \
    wget \
    git \
    terraform \
    openssh-client \
    openssl \
    docker \
    docker-compose \
    && rm -rf /var/cache/apk/*

# Create migration user
RUN addgroup -g 1001 migration && \
    adduser -S migration -u 1001 -G migration

# Setup working directory
WORKDIR /opt/migration

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy migration scripts
COPY scripts/ai-migrate.js ./
COPY terraform/ ./terraform/

# Create necessary directories
RUN mkdir -p data backups terraform/state logs

# Generate SSH keys for migration
RUN ssh-keygen -t rsa -b 4096 -f /root/.ssh/migration_key -N ""

# Copy SSH keys to migration user
RUN cp /root/.ssh/migration_key* /home/migration/.ssh/ && \
    chown -R migration:migration /home/migration/.ssh && \
    chmod 600 /home/migration/.ssh/migration_key

# Switch to migration user
USER migration

# Health check
HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD node -e "console.log('Migration OK')"

# Run migration coordinator
CMD ["node", "ai-migrate.js", "monitor"]