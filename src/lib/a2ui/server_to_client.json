{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.dev/specification/0.9/server_to_client.json",
  "title": "A2UI Server to Client Message",
  "description": "Schema for messages sent from A2UI server to client",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["createSurface", "updateComponents", "updateDataModel", "destroySurface", "executeAction"]
    },
    "surfaceId": {
      "type": "string",
      "description": "Unique identifier for the surface being manipulated"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the message"
    },
    "data": {
      "type": "object",
      "description": "Message-specific data payload",
      "oneOf": [
        {
          "$ref": "#/$defs/CreateSurfaceData"
        },
        {
          "$ref": "#/$defs/UpdateComponentsData"
        },
        {
          "$ref": "#/$defs/UpdateDataModelData"
        },
        {
          "$ref": "#/$defs/DestroySurfaceData"
        },
        {
          "$ref": "#/$defs/ExecuteActionData"
        }
      ]
    }
  },
  "required": ["type", "surfaceId", "timestamp", "data"],
  "$defs": {
    "CreateSurfaceData": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the surface"
        },
        "description": {
          "type": "string",
          "description": "Description of the surface"
        },
        "catalogUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to the component catalog"
        },
        "rootComponent": {
          "type": "string",
          "description": "ID of the root component"
        }
      },
      "required": ["title", "catalogUrl", "rootComponent"]
    },
    "UpdateComponentsData": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentDefinition"
          },
          "description": "Array of component definitions to add or update"
        }
      },
      "required": ["components"]
    },
    "UpdateDataModelData": {
      "type": "object",
      "properties": {
        "dataModel": {
          "type": "object",
          "description": "Data model to merge into the surface's data model"
        }
      },
      "required": ["dataModel"]
    },
    "DestroySurfaceData": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "description": "Reason for destroying the surface"
        }
      }
    },
    "ExecuteActionData": {
      "type": "object",
      "properties": {
        "actionId": {
          "type": "string",
          "description": "ID of the action to execute"
        },
        "parameters": {
          "type": "object",
          "description": "Parameters for the action execution"
        }
      },
      "required": ["actionId"]
    },
    "ComponentDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the component"
        },
        "componentType": {
          "type": "string",
          "description": "Type of component from the catalog"
        },
        "properties": {
          "type": "object",
          "description": "Component-specific properties"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of child components"
        },
        "parentId": {
          "type": "string",
          "description": "ID of parent component"
        }
      },
      "required": ["id", "componentType"]
    }
  }
}