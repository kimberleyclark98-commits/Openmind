# OpenMind Fuel System
# Dedicated container for income generation

FROM node:18-alpine

WORKDIR /opt/fuel

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy fuel system
COPY scripts/ai-earn.js ./
COPY src/ai/survival/fuel-system.ts ./src/ai/survival/
COPY src/ai/wallet/autonomous-wallet.ts ./src/ai/wallet/

# Create fuel config if not exists
RUN echo '{"minSurvivalBudget":4.5,"monthlyServerCost":1.5,"headhuntCommissionRate":0.15,"automationFee":0.05}' > fuel-config.json

# Health check
HEALTHCHECK --interval=300s --timeout=30s --retries=3 \
    CMD node -e "console.log('Fuel system active')"

# Environment
ENV FUEL_MODE=continuous

# Run fuel system
CMD ["node", "ai-earn.js", "start"]